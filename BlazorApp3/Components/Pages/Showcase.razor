@page "/components"
@attribute [HasPermission(Perm.ComponentsView)]
@inject ToastService Toast
@inject LoadingService Loading
@inject ConfirmService Confirm
@inject UiDispatcher Ui
@inject IJSRuntime JS
@inject BrandingState Branding

<AppPageTitle Title="Componentes" />

<PageHeader Title="Vitrine de componentes" Subtitle="Teste todos os componentes reutilizáveis da aplicação" Icon="bi-boxes" />

<div class="row g-3">
    @* ---------------- Toasts *@
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header-x"><h6><i class="bi bi-bell me-2"></i>Toasts</h6></div>
            <div class="card-body d-flex flex-wrap gap-2 align-items-start align-content-start">
                <button class="btn btn-success" @onclick='() => Toast.Success("Salvo com sucesso", "O registro foi atualizado.")'>Sucesso</button>
                <button class="btn btn-danger" @onclick='() => Toast.Error("Falha na operação", "Não foi possível conectar ao servidor.")'>Erro</button>
                <button class="btn btn-warning" @onclick='() => Toast.Warning("Atenção", "Sua sessão expira em 5 minutos.")'>Aviso</button>
                <button class="btn btn-info text-white" @onclick='() => Toast.Info("Novidade", "Confira os novos relatórios.")'>Info</button>
                <button class="btn btn-outline-secondary" @onclick="Burst">Rajada (5)</button>
                <button class="btn btn-outline-secondary" @onclick='() => Toast.Show(ToastLevel.Info, "Persistente", "Só fecha manualmente.", 0)'>Sem auto-fechar</button>
            </div>
        </div>
    </div>

    @* ---------------- Loadings *@
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header-x"><h6><i class="bi bi-hourglass-split me-2"></i>Loadings</h6></div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button class="btn btn-primary" @onclick="GlobalLoading">Overlay global (2s)</button>
                    <LoadingButton Loading="_btnLoading" OnClick="ButtonLoading" Class="btn-outline-primary" Icon="bi-cloud-download" LoadingText="Processando...">Botão com loading</LoadingButton>
                    <button class="btn btn-outline-secondary" @onclick="ToggleSkeleton">Recarregar skeleton</button>
                </div>
                <div class="d-flex align-items-center gap-4 mb-3">
                    <Spinner Size="sm" /><Spinner /><Spinner Size="lg" /><Spinner Text="Carregando dados..." />
                </div>
                @if (_skeleton)
                {
                    <div class="d-flex gap-3"><Skeleton Type="circle" Width="48px" Height="48px" /><div class="flex-grow-1"><Skeleton Lines="3" /></div></div>
                }
                else
                {
                    <div class="d-flex gap-3 page-enter"><Avatar Name="Conteúdo Carregado" Size="48" /><div><strong>Conteúdo carregado!</strong><div class="text-muted small">O skeleton é exibido enquanto os dados chegam.</div></div></div>
                }
            </div>
        </div>
    </div>

    @* ---------------- Dialogs *@
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header-x"><h6><i class="bi bi-window-stack me-2"></i>Dialogs (central e lateral)</h6></div>
            <div class="card-body d-flex flex-wrap gap-2 align-items-start align-content-start">
                <button class="btn btn-outline-primary" @onclick='() => OpenModal("sm")'>Modal pequeno</button>
                <button class="btn btn-outline-primary" @onclick='() => OpenModal("md")'>Modal médio</button>
                <button class="btn btn-outline-primary" @onclick='() => OpenModal("lg")'>Modal grande</button>
                <button class="btn btn-outline-primary" @onclick='() => OpenModal("xl")'>Modal XL</button>
                <button class="btn btn-outline-secondary" @onclick='() => OpenDrawer("end")'>Lateral direita</button>
                <button class="btn btn-outline-secondary" @onclick='() => OpenDrawer("start")'>Lateral esquerda</button>
            </div>
        </div>
    </div>

    @* ---------------- Confirmações *@
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header-x"><h6><i class="bi bi-patch-question me-2"></i>Confirmação de exclusão</h6></div>
            <div class="card-body d-flex flex-wrap gap-2 align-items-start align-content-start">
                <button class="btn btn-outline-danger" @onclick="SimpleDelete"><i class="bi bi-trash3 me-1"></i>Excluir simples</button>
                <button class="btn btn-danger" @onclick="CriticalDelete"><i class="bi bi-exclamation-octagon me-1"></i>Excluir crítico (digitar nome)</button>
                <button class="btn btn-outline-secondary" @onclick="GenericConfirm">Confirmação genérica</button>
                @if (_confirmResult is not null)
                {
                    <div class="w-100 small text-muted">Resultado: <strong>@_confirmResult</strong></div>
                }
            </div>
        </div>
    </div>

    @* ---------------- Upload *@
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header-x"><h6><i class="bi bi-cloud-arrow-up me-2"></i>Upload de arquivos</h6></div>
            <div class="card-body">
                <FileUpload Folder="showcase" Multiple="true" MaxFiles="5" MaxSizeMb="10" OnUploaded="f => _uploaded.Add(f)" />
                <div class="mt-3">
                    <label class="form-label small">Upload de imagem com preview</label>
                    <ImageUpload @bind-Value="_image" Folder="showcase" Shape="circle" Size="80" />
                </div>
            </div>
        </div>
    </div>

    @* ---------------- Busca lazy *@
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header-x"><h6><i class="bi bi-search me-2"></i>Busca lazy</h6></div>
            <div class="card-body">
                <label class="form-label small">Autocomplete paginado (consulta o banco sob demanda)</label>
                <LazyAutocomplete TItem="UserLookup" SearchFunc="(t, p, s) => Ui.QueryAsync(new LookupUsersQuery(t, p, s))" OnSelected="u => _picked = u" PageSize="6">
                    <ItemTemplate Context="u">
                        <Avatar Name="@u.FullName" Size="28" />
                        <div class="text-start min-w-0"><div class="text-truncate">@u.FullName</div><small class="text-muted">@u.Email</small></div>
                    </ItemTemplate>
                </LazyAutocomplete>
                @if (_picked is not null)
                {
                    <div class="alert alert-light border mt-2 py-2 small"><i class="bi bi-check2-circle text-success me-1"></i>Selecionado: <strong>@_picked.FullName</strong> (@_picked.Department)</div>
                }

                <label class="form-label small mt-3">Lista virtualizada com rolagem infinita (carrega lotes conforme rola)</label>
                <div class="virtual-list">
                    <Virtualize ItemsProvider="LoadVirtual" ItemComparer="UserComparer" ItemSize="52" OverscanCount="6" Context="u">
                        <ItemContent>
                            <div class="virtual-item">
                                <Avatar Name="@u.FullName" Size="30" />
                                <div class="min-w-0"><div class="text-truncate">@u.FullName</div><small class="text-muted">@u.Department</small></div>
                            </div>
                        </ItemContent>
                        <Placeholder>
                            <div class="virtual-item"><Skeleton Type="circle" Width="30px" Height="30px" /><Skeleton Width="60%" /></div>
                        </Placeholder>
                    </Virtualize>
                </div>
                <small class="text-muted">Lotes carregados: @_virtualLoads</small>
            </div>
        </div>
    </div>

    @* ---------------- Paginação + multi filtros *@
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header-x"><h6><i class="bi bi-funnel me-2"></i>Paginação e multi filtros</h6></div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <MultiSelect TValue="string" Options="_fruitOptions" @bind-Selected="_fruits" Placeholder="Categorias" Icon="bi-tags" />
                    <SearchInput @bind-Value="_demoSearch" Placeholder="Filtrar..." DebounceMs="250" Class="flex-grow-1" />
                </div>
                <ul class="list-group mb-3">
                    @foreach (var item in DemoPage)
                    {
                        <li class="list-group-item d-flex justify-content-between row-enter" @key="item">@item.Name <ColorBadge Color="@item.Color">@item.Category</ColorBadge></li>
                    }
                </ul>
                <Pagination Page="_demoPage" PageSize="_demoSize" TotalCount="DemoFiltered.Count()" PageSizeOptions="[5, 10]"
                            PageChanged="p => _demoPage = p" PageSizeChanged="s => { _demoSize = s; _demoPage = 1; }" />
            </div>
        </div>
    </div>

    @* ---------------- Efeitos *@
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header-x"><h6><i class="bi bi-stars me-2"></i>Efeitos de página</h6></div>
            <div class="card-body">
                <p class="small text-muted">Transição atual (configurada no whitelabel): <strong>@EffectiveBranding.Transitions[Branding.Effective.PageTransition]</strong></p>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var (key, label) in EffectiveBranding.Transitions)
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => JS.InvokeVoidAsync(GlobalFx, key)">@label</button>
                    }
                </div>
                <div class="fx-demo-grid mt-3">
                    @for (var i = 0; i < 6; i++)
                    {
                        <div @key="(_staggerKey, i)" class="fx-demo-box fx-stagger" style="--i:@i"></div>
                    }
                </div>
                <button class="btn btn-sm btn-link px-0" @onclick="() => _staggerKey++">Repetir animação em cascata</button>
            </div>
        </div>
    </div>
</div>

<Modal @bind-Visible="_modalOpen" Title="@($"Modal {_modalSize.ToUpperInvariant()}")" Subtitle="Dialog central com animação" Icon="bi-window" Size="@_modalSize">
    <ChildContent>
        <p>Feche com <kbd>Esc</kbd>, clicando fora ou no botão. Dialogs podem ser empilhados:</p>
        <button class="btn btn-outline-danger btn-sm" @onclick="SimpleDelete">Abrir confirmação por cima</button>
        @if (_modalSize is "lg" or "xl")
        {
            <div class="mt-3"><Skeleton Lines="6" /></div>
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="() => _modalOpen = false">Fechar</button>
        <button class="btn btn-primary" @onclick='() => { _modalOpen = false; Toast.Success("Confirmado!"); }'>OK</button>
    </Footer>
</Modal>

<Drawer @bind-Visible="_drawerOpen" Position="@_drawerPos" Title="Dialog lateral" Subtitle="@(_drawerPos == "end" ? "Abre pela direita" : "Abre pela esquerda")" Icon="bi-layout-sidebar-reverse" Width="420px">
    <ChildContent>
        <p class="text-muted">Ideal para formulários de criação/edição sem perder o contexto da listagem.</p>
        <div class="mb-3"><label class="form-label">Campo de exemplo</label><input class="form-control" placeholder="Digite algo..." /></div>
        <Skeleton Lines="5" />
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="() => _drawerOpen = false">Fechar</button>
    </Footer>
</Drawer>

@code {
    private const string GlobalFx = "appFx.pageEnter";
    private static readonly IEqualityComparer<UserLookup> UserComparer = EqualityComparer<UserLookup>.Create((a, b) => a?.Id == b?.Id, u => u.Id.GetHashCode());

    private bool _btnLoading;
    private bool _skeleton = true;
    private bool _modalOpen;
    private string _modalSize = "md";
    private bool _drawerOpen;
    private string _drawerPos = "end";
    private string? _confirmResult;
    private readonly List<UploadedFile> _uploaded = [];
    private string? _image;
    private UserLookup? _picked;
    private int _virtualLoads;
    private int _staggerKey;

    private sealed record DemoItem(string Name, string Category, string Color);
    private static readonly DemoItem[] DemoData = Enumerable.Range(1, 47).Select(i => (i % 4) switch
    {
        0 => new DemoItem($"Item {i:00}", "Financeiro", "#059669"),
        1 => new DemoItem($"Item {i:00}", "Marketing", "#db2777"),
        2 => new DemoItem($"Item {i:00}", "Tecnologia", "#4f46e5"),
        _ => new DemoItem($"Item {i:00}", "Vendas", "#ea580c")
    }).ToArray();

    private readonly List<SelectOption<string>> _fruitOptions = DemoData.Select(d => d.Category).Distinct()
        .Select(c => new SelectOption<string>(c, c, DemoData.First(d => d.Category == c).Color)).ToList();
    private List<string> _fruits = [];
    private string? _demoSearch;
    private int _demoPage = 1;
    private int _demoSize = 5;

    private IEnumerable<DemoItem> DemoFiltered => DemoData.Where(d =>
        (_fruits.Count == 0 || _fruits.Contains(d.Category)) &&
        (string.IsNullOrWhiteSpace(_demoSearch) || d.Name.Contains(_demoSearch, StringComparison.OrdinalIgnoreCase)));
    private IEnumerable<DemoItem> DemoPage => DemoFiltered.Skip((Math.Min(_demoPage, Math.Max(1, (int)Math.Ceiling(DemoFiltered.Count() / (double)_demoSize))) - 1) * _demoSize).Take(_demoSize);

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(1200);
        _skeleton = false;
    }

    private async Task Burst()
    {
        var levels = Enum.GetValues<ToastLevel>();
        for (var i = 0; i < 5; i++)
        {
            Toast.Show(levels[i % levels.Length], $"Notificação #{i + 1}", "Toasts empilham e saem com animação.");
            await Task.Delay(150);
        }
    }

    private Task GlobalLoading() => Loading.RunAsync(() => Task.Delay(2000), "Processando sua solicitação...");

    private async Task ButtonLoading()
    {
        _btnLoading = true;
        await Task.Delay(1800);
        _btnLoading = false;
        Toast.Success("Concluído");
    }

    private async Task ToggleSkeleton()
    {
        _skeleton = true;
        StateHasChanged();
        await Task.Delay(1200);
        _skeleton = false;
    }

    private void OpenModal(string size) { _modalSize = size; _modalOpen = true; }
    private void OpenDrawer(string pos) { _drawerPos = pos; _drawerOpen = true; }

    private async Task SimpleDelete()
    {
        var ok = await Confirm.DeleteAsync("Relatório Mensal.pdf");
        _confirmResult = ok ? "confirmado" : "cancelado";
        if (ok) Toast.Success("Excluído", "Relatório Mensal.pdf");
    }

    private async Task CriticalDelete()
    {
        var ok = await Confirm.DeleteAsync("Time Financeiro", "Todos os vínculos serão removidos permanentemente.", requireText: "Time Financeiro");
        _confirmResult = ok ? "confirmado (texto digitado)" : "cancelado";
        if (ok) Toast.Success("Excluído", "Time Financeiro");
    }

    private async Task GenericConfirm()
    {
        var ok = await Confirm.ShowAsync(new ConfirmOptions
        {
            Title = "Publicar alterações?",
            Message = new MarkupString("As alterações ficarão visíveis para <strong>todos os usuários</strong>."),
            ConfirmText = "Publicar",
            Icon = "bi-send"
        });
        _confirmResult = ok ? "publicado" : "cancelado";
    }

    private async ValueTask<ItemsProviderResult<UserLookup>> LoadVirtual(ItemsProviderRequest request)
    {
        // O Virtualize pede apenas a faixa visível (startIndex/count) — consulta lazy no banco
        var (items, total) = await Ui.QueryAsync(new UsersRangeQuery(request.StartIndex, request.Count));
        _virtualLoads++;
        return new ItemsProviderResult<UserLookup>(items, total);
    }
}
