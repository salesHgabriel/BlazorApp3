@page "/roles"
@attribute [HasPermission(Perm.RolesView)]
@inject UiDispatcher Ui
@inject IAuthorizationService Authz

<AppPageTitle Title="@L["Papéis"]" />

<PageHeader Title="@L["Papéis (roles)"]" Subtitle="@L["Roles são criadas dinamicamente e agrupam permissões fixas do sistema"]" Icon="bi-person-badge">
    <Actions>
        <Can Permission="@Perm.RolesCreate">
            <button class="btn btn-primary" @onclick="() => OpenEditor(null)"><i class="bi bi-plus-lg me-1"></i>@L["Novo papel"]</button>
        </Can>
    </Actions>
</PageHeader>

<div class="card">
    <div class="filter-bar">
        <SearchInput Value="@_query.Search" ValueChanged="v => _list.ApplyAsync(() => _query.Search = v)" Placeholder="@L["Buscar papel..."]" Busy="_list.Loading" Class="flex-grow-1" />
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 data-table">
            <thead>
                <tr>
                    <SortHeader Label="@L["Papel"]" Field="name" Current="@_query.SortBy" Desc="_query.SortDesc" OnSort="OnSort" />
                    <SortHeader Label="@L["Usuários"]" Field="users" Current="@_query.SortBy" Desc="_query.SortDesc" OnSort="OnSort" />
                    <SortHeader Label="@L["Permissões"]" Field="permissions" Current="@_query.SortBy" Desc="_query.SortDesc" OnSort="OnSort" />
                    <SortHeader Label="@L["Criado em"]" Field="created" Current="@_query.SortBy" Desc="_query.SortDesc" OnSort="OnSort" Class="d-none d-md-table-cell" />
                    <th style="width:110px"></th>
                </tr>
            </thead>
            <tbody class="@(_list.IsRefreshing ? "is-refreshing" : "")">
                @if (_list.IsInitialLoad)
                {
                    <TableSkeleton Rows="6" Columns="5" />
                }
                else if (_list.IsEmpty)
                {
                    <tr><td colspan="5"><EmptyState Icon="bi-person-badge" Title="@L["Nenhum papel encontrado"]" /></td></tr>
                }
                else
                {
                    @foreach (var r in _list.Items)
                    {
                        <tr @key="r.Id" class="row-enter">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="role-icon" style="--badge-color:@r.Color"><i class="bi bi-shield-check"></i></span>
                                    <div>
                                        <div class="fw-semibold">
                                            @r.Name
                                            @if (r.IsSystem)
                                            {
                                                <span class="badge text-bg-dark ms-1" title="@L["Papel de sistema"]"><i class="bi bi-lock-fill"></i> @L["Sistema"].Value.ToLower()</span>
                                            }
                                        </div>
                                        <div class="small text-muted">@r.Description</div>
                                    </div>
                                </div>
                            </td>
                            <td><a href="users?role=@r.Id" title="@L["Ver usuários com este papel"]"><i class="bi bi-people me-1"></i>@r.UserCount</a></td>
                            <td>
                                <div class="perm-meter" title="@L["{0} de {1}", r.PermissionCount, Perm.All.Count]">
                                    <div style="width:@(r.PermissionCount * 100 / Perm.All.Count)%;background:@r.Color"></div>
                                </div>
                                <small class="text-muted">@r.PermissionCount / @Perm.All.Count</small>
                            </td>
                            <td class="d-none d-md-table-cell small text-muted">@r.CreatedAt.ToLocalTime().ToString("d")</td>
                            <td class="text-end text-nowrap">
                                <button class="icon-btn" title="@(_canUpdate ? L["Editar"] : L["Visualizar"])" @onclick="() => OpenEditor(r.Id)"><i class="bi @(_canUpdate ? "bi-pencil" : "bi-eye")"></i></button>
                                @if (!r.IsSystem)
                                {
                                    <Can Permission="@Perm.RolesDelete">
                                        <button class="icon-btn text-danger" title="@L["Excluir"]" @onclick="() => DeleteAsync(r)"><i class="bi bi-trash3"></i></button>
                                    </Can>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer-x">
        <PagedPager State="_list" />
    </div>
</div>

<RoleEditor @bind-Visible="_editorOpen" RoleId="@_editingId" CanEdit="@(_editingId is null ? _canCreate : _canUpdate)" OnSaved="_list.LoadAsync" />

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private readonly SearchRolesQuery _query = new();
    private PagedQueryState<RoleListItem> _list = default!;
    private bool _editorOpen;
    private string? _editingId;
    private bool _canCreate;
    private bool _canUpdate;

    protected override async Task OnInitializedAsync()
    {
        _list = Ui.Paged(_query, StateHasChanged);
        var user = (await AuthState).User;
        _canCreate = (await Authz.AuthorizeAsync(user, Perm.Policy(Perm.RolesCreate))).Succeeded;
        _canUpdate = (await Authz.AuthorizeAsync(user, Perm.Policy(Perm.RolesEdit))).Succeeded;
        await _list.LoadAsync();
    }

    private Task OnSort((string Field, bool Desc) s) => _list.ApplyAsync(() =>
    {
        _query.SortBy = s.Field;
        _query.SortDesc = s.Desc;
    });

    private void OpenEditor(string? id)
    {
        _editingId = id;
        _editorOpen = true;
    }

    private async Task DeleteAsync(RoleListItem role)
    {
        var details = role.UserCount > 0 ? L["{0} usuário(s) perderão este papel e suas permissões.", role.UserCount].Value : null;
        if (await Ui.DeleteAsync(new DeleteRoleCommand(role.Id), role.Name, details, success: L["Papel excluído"]))
            await _list.LoadAsync();
    }
}
