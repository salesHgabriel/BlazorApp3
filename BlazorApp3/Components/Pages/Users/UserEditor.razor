@inherits EditorBase<UserEditModel>

@* Dialog lateral (Drawer) para criar/editar usuário *@
<Drawer Visible="Visible" VisibleChanged="VisibleChanged" Title="@(UserId is null ? "Novo usuário" : "Editar usuário")"
        Subtitle="@(UserId is null ? "Preencha os dados de acesso" : Model?.Email)" Icon="@(UserId is null ? "bi-person-plus" : "bi-pencil-square")"
        Width="560px" CloseOnBackdrop="!Saving">
    <ChildContent>
        @if (Model is null)
        {
            <div class="d-flex gap-3 mb-4"><Skeleton Type="circle" Width="72px" Height="72px" /><div class="flex-grow-1"><Skeleton Lines="2" /></div></div>
            <Skeleton Lines="8" />
        }
        else
        {
            <EditForm id="user-form" Model="Model" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />

                <div class="form-section">Foto</div>
                <ImageUpload @bind-Value="Model.AvatarUrl" Folder="avatars" Shape="circle" Size="72" />

                <div class="form-section">Dados pessoais</div>
                <div class="mb-3">
                    <label class="form-label">Nome completo *</label>
                    <InputText class="form-control" @bind-Value="Model.FullName" />
                    <ValidationMessage For="() => Model.FullName" class="text-danger small" />
                </div>
                <div class="mb-3">
                    <label class="form-label">E-mail (login) *</label>
                    <InputText class="form-control" @bind-Value="Model.Email" type="email" />
                    <ValidationMessage For="() => Model.Email" class="text-danger small" />
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label">Cargo</label>
                        <InputText class="form-control" @bind-Value="Model.JobTitle" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">Departamento</label>
                        <InputText class="form-control" @bind-Value="Model.Department" list="dept-list" />
                        <datalist id="dept-list">
                            @foreach (var d in Departments)
                            {
                                <option value="@d"></option>
                            }
                        </datalist>
                    </div>
                </div>

                <div class="form-section">Acesso</div>
                <div class="mb-3">
                    <label class="form-label">@(UserId is null ? "Senha *" : "Nova senha")</label>
                    <InputText class="form-control" type="password" @bind-Value="Model.Password" autocomplete="new-password"
                               placeholder="@(UserId is null ? "Mínimo 6 caracteres, com maiúscula e número" : "Deixe em branco para manter a atual")" />
                    <ValidationMessage For="() => Model.Password" class="text-danger small" />
                </div>
                <div class="form-check form-switch mb-3">
                    <InputCheckbox class="form-check-input" id="active" @bind-Value="Model.IsActive" />
                    <label class="form-check-label" for="active">Usuário ativo (pode fazer login)</label>
                </div>

                <label class="form-label">Papéis (roles)</label>
                <div class="check-grid mb-3">
                    @foreach (var role in RoleOptions)
                    {
                        var id = role.Value;
                        <label class="check-card @(Model.RoleIds.Contains(id) ? "checked" : "")">
                            <input type="checkbox" class="form-check-input" checked="@Model.RoleIds.Contains(id)" @onchange="() => ToggleRole(id)" />
                            <span class="dot" style="background:@role.Color"></span>
                            <span>@role.Label</span>
                        </label>
                    }
                </div>

                <label class="form-label">Times</label>
                <MultiSelect TValue="int" Options="TeamOptions" @bind-Selected="Model.TeamIds" Placeholder="Times" Icon="bi-diagram-3" Class="w-100" />
            </EditForm>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light" disabled="@Saving" @onclick="CloseAsync">Cancelar</button>
        <LoadingButton Type="submit" form="user-form" Loading="Saving" LoadingText="Salvando..." Icon="bi-check2">Salvar</LoadingButton>
    </Footer>
</Drawer>

@code {
    [Parameter] public string? UserId { get; set; }
    [Parameter] public List<SelectOption<string>> RoleOptions { get; set; } = [];
    [Parameter] public List<SelectOption<int>> TeamOptions { get; set; } = [];
    [Parameter] public List<string> Departments { get; set; } = [];

    protected override Task<UserEditModel?> LoadModelAsync() =>
        UserId is null ? Task.FromResult<UserEditModel?>(new UserEditModel()) : Ui.QueryAsync(new GetUserForEditQuery(UserId));

    protected override async Task<bool> SaveAsync(UserEditModel model) => model.Id is null
        ? (await Ui.SendAsync(new CreateUserCommand(model), "Usuário criado", model.FullName, errorTitle: "Verifique os dados")).Succeeded
        : (await Ui.SendAsync(new UpdateUserCommand(model), "Usuário atualizado", model.FullName, errorTitle: "Verifique os dados")).Succeeded;

    private void ToggleRole(string id)
    {
        if (!Model!.RoleIds.Remove(id)) Model.RoleIds.Add(id);
    }
}
