@implements IDisposable
@inject BrandingState Branding

<div class="sidebar-brand">
    <BrandLogo Name="@Branding.Effective.AppName" LogoUrl="@Branding.Effective.LogoUrl" ShowName="!Collapsed" />
</div>
@if (!Collapsed && Branding.ActiveTeam is { } team)
{
    <div class="sidebar-team">
        <span class="dot" style="background:@team.PrimaryColor"></span>
        <span class="text-truncate">@team.Name</span>
    </div>
}

<nav class="sidebar-nav">
    <div class="nav-section">@L["Visão geral"]</div>
    <NavLink class="side-link" href="" Match="NavLinkMatch.All" title="@L["Dashboard"]">
        <i class="bi bi-grid-1x2"></i><span>@L["Dashboard"]</span>
    </NavLink>

    <Can Any="[Perm.UsersView, Perm.TeamsView]">
        <div class="nav-section">@L["Gestão"]</div>
    </Can>
    <Can Permission="@Perm.UsersView">
        <NavLink class="side-link" href="users" title="@L["Usuários"]"><i class="bi bi-people"></i><span>@L["Usuários"]</span></NavLink>
    </Can>
    <Can Permission="@Perm.TeamsView">
        <NavLink class="side-link" href="teams" title="@L["Times"]"><i class="bi bi-diagram-3"></i><span>@L["Times"]</span></NavLink>
    </Can>

    <Can Any="[Perm.RolesView, Perm.PermissionsView]">
        <div class="nav-section">@L["Segurança"]</div>
    </Can>
    <Can Permission="@Perm.RolesView">
        <NavLink class="side-link" href="roles" title="@L["Papéis"]"><i class="bi bi-person-badge"></i><span>@L["Papéis (roles)"]</span></NavLink>
    </Can>
    <Can Permission="@Perm.PermissionsView">
        <NavLink class="side-link" href="permissions" title="@L["Permissões"]"><i class="bi bi-key"></i><span>@L["Permissões"]</span></NavLink>
    </Can>

    <Can Any="[Perm.BrandingView, Perm.ComponentsView]">
        <div class="nav-section">@L["Configurações"]</div>
    </Can>
    <Can Permission="@Perm.BrandingView">
        <NavLink class="side-link" href="settings/branding" title="@L["Whitelabel"]"><i class="bi bi-palette"></i><span>@L["Whitelabel"]</span></NavLink>
    </Can>
    <Can Permission="@Perm.ComponentsView">
        <NavLink class="side-link" href="components" title="@L["Componentes"]"><i class="bi bi-boxes"></i><span>@L["Componentes"]</span></NavLink>
    </Can>
</nav>

@code {
    [Parameter] public bool Collapsed { get; set; }

    protected override void OnInitialized() => Branding.Changed += OnChanged;
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Branding.Changed -= OnChanged;
}
