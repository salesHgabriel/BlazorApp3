@page "/Account/Login"
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject NavigationManager Nav
@inject IDispatcher Dispatcher
@inject EmailConfirmationService Confirmation
@inject UserSessions Sessions
@inject INotifier Notifier
@inject SystemSettingsProvider SettingsProvider

<PageTitle>@L["Entrar"] · @_appName</PageTitle>

<h1 class="h3 fw-bold mb-1">@_title</h1>
<p class="text-muted mb-4">@_message</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger d-flex align-items-center gap-2 py-2" role="alert">
        <i class="bi bi-exclamation-octagon"></i><span>@_error</span>
    </div>
}

<EditForm Model="Input" method="post" OnValidSubmit="LoginAsync" FormName="login" Enhance="false">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label for="email" class="form-label">@L["E-mail"]</label>
        <div class="input-icon">
            <i class="bi bi-envelope"></i>
            <InputText id="email" @bind-Value="Input!.Email" class="form-control" autocomplete="username" placeholder="@L["voce@empresa.com"]" />
        </div>
        <ValidationMessage For="() => Input.Email" class="text-danger small" />
    </div>
    <div class="mb-3">
        <label for="password" class="form-label">@L["Senha"]</label>
        <div class="input-icon">
            <i class="bi bi-lock"></i>
            <InputText id="password" type="password" @bind-Value="Input.Password" class="form-control" autocomplete="current-password" placeholder="••••••••" />
        </div>
        <ValidationMessage For="() => Input.Password" class="text-danger small" />
    </div>
    <div class="form-check mb-4">
        <InputCheckbox id="remember" @bind-Value="Input.RememberMe" class="form-check-input" />
        <label for="remember" class="form-check-label">@L["Manter conectado"]</label>
    </div>
    <button type="submit" class="btn btn-primary w-100 py-2">
        <i class="bi bi-box-arrow-in-right me-1"></i> @L["Entrar"]
    </button>
</EditForm>

@if (_registrationEnabled)
{
    <p class="text-center small text-muted mt-3 mb-0">
        @L["Ainda não tem conta?"] <a href="Account/Register" data-enhance-nav="false" class="fw-semibold">@L["Criar conta"]</a>
    </p>
}

<div class="demo-accounts mt-4">
    <div class="small fw-semibold mb-2"><i class="bi bi-magic me-1"></i>@L["Contas de demonstração (clique para preencher)"]</div>
    <div class="demo-grid">
        @foreach (var acc in DbSeeder.DemoAccounts)
        {
            <button type="button" class="demo-account" onclick="appFx.fillLogin('@acc.Email','@acc.Password')">
                <strong>@acc.Role</strong>
                <span>@acc.Email</span>
                @if (!acc.Active)
                {
                    <em>@L["Inativo"].Value.ToLower()</em>
                }
            </button>
        }
    </div>
    <div class="small text-muted mt-2">@L["Usuários gerados pelo seed usam a senha"] <code>Demo@123</code>.</div>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private LoginInput? Input { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private string? _error;
    private string _appName = "";
    private string _title = "";
    private string _message = "";
    private bool _registrationEnabled;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        var b = await Dispatcher.QueryAsync(new GetBrandingQuery());
        _appName = b.AppName;
        _title = b.LoginTitle ?? L["Entrar"];
        _message = b.LoginMessage ?? "";
        _registrationEnabled = (await SettingsProvider.GetAsync()).RegistrationEnabled;
    }

    private async Task LoginAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input!.Email.Trim());
        if (user is null)
        {
            _error = L["E-mail ou senha inválidos."];
            return;
        }
        if (!user.IsActive)
        {
            _error = L["Sua conta está inativa. Contate o administrador."];
            return;
        }

        // Bloqueada (pelo administrador ou por excesso de tentativas). Motivo só aparece com a senha correta.
        if (await UserManager.IsLockedOutAsync(user))
        {
            if (BlockState.IsAdminBlock(user) && await UserManager.CheckPasswordAsync(user, Input.Password))
            {
                _error = BlockState.IsPermanent(user.LockoutEnd)
                    ? L["Sua conta foi bloqueada por um administrador."]
                    : L["Sua conta está bloqueada até {0}.", user.LockoutEnd!.Value.ToLocalTime().ToString("g")];
                if (!string.IsNullOrWhiteSpace(user.BlockReason)) _error += " " + L["Motivo: {0}", user.BlockReason];
            }
            else
            {
                _error = L["Conta bloqueada temporariamente por excesso de tentativas. Tente novamente em alguns minutos."];
            }
            return;
        }

        // E-mail ainda não confirmado: com a senha correta, envia um código novo e leva para a tela de confirmação
        var settings = await SettingsProvider.GetAsync();
        if (settings.RequireEmailConfirmation && !user.EmailConfirmed)
        {
            if (await UserManager.CheckPasswordAsync(user, Input.Password))
            {
                await Confirmation.IssueCodeAsync(user); // respeita o intervalo de reenvio
                Nav.NavigateTo($"/Account/ConfirmEmail?email={Uri.EscapeDataString(user.Email!)}&pending=1", forceLoad: true);
                return;
            }
            await UserManager.AccessFailedAsync(user);
            _error = L["E-mail ou senha inválidos."];
            return;
        }

        var result = await SignInManager.CheckPasswordSignInAsync(user, Input.Password, lockoutOnFailure: true);
        if (result.IsLockedOut)
        {
            Notifier.LockoutAlert(user.Id); // acabou de bloquear por excesso de tentativas
            _error = L["Conta bloqueada temporariamente por excesso de tentativas. Tente novamente em alguns minutos."];
            return;
        }
        if (!result.Succeeded)
        {
            _error = L["E-mail ou senha inválidos."];
            return;
        }

        var target = !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") ? ReturnUrl : "/";

        // MFA ativo: guarda o usuário num cookie temporário do Identity e pede o código do app autenticador
        if (user.TwoFactorEnabled)
        {
            await UserSessions.BeginTwoFactorAsync(HttpContext, user.Id, Input.RememberMe);
            Nav.NavigateTo($"/Account/LoginWith2fa?returnUrl={Uri.EscapeDataString(target)}", forceLoad: true);
            return;
        }

        // Nova sessão (sessão única: encerra as outras; senão avisa as outras em tempo real)
        await Sessions.SignInAsync(SignInManager, user, Input.RememberMe);
        Nav.NavigateTo(target, forceLoad: true);
    }

    private sealed class LoginInput
    {
        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.EmailRequired)), EmailAddress(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.EmailInvalid))]
        public string Email { get; set; } = "";

        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.PasswordRequired))]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
