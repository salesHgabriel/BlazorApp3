@page "/Account/LoginWith2fa"
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject UserSessions Sessions
@inject INotifier Notifier
@inject NavigationManager Nav
@inject IDispatcher Dispatcher

<PageTitle>@L["Verificação em duas etapas"] · @_appName</PageTitle>

@* Segunda etapa do login (MFA). O usuário vem de um cookie temporário do Identity gravado na tela de login (5 min). *@
<div class="text-center mb-4">
    <div class="auth-state-icon"><i class="bi bi-shield-lock"></i></div>
    <h1 class="h3 fw-bold mt-3 mb-1">@L["Verificação em duas etapas"]</h1>
    <p class="text-muted mb-0">
        @(UseRecovery ? L["Digite um dos seus códigos de recuperação."] : L["Abra o app autenticador e digite o código de 6 dígitos."])
    </p>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger d-flex align-items-start gap-2 py-2" role="alert">
        <i class="bi bi-exclamation-octagon mt-1"></i><span>@_error</span>
    </div>
}

<EditForm Model="Input" method="post" OnValidSubmit="VerifyAsync" FormName="login-2fa" Enhance="false">
    <DataAnnotationsValidator />
    @if (UseRecovery)
    {
        <div class="mb-3">
            <div class="input-icon">
                <i class="bi bi-key"></i>
                <InputText id="code" @bind-Value="Input!.Code" class="form-control text-uppercase" autocomplete="off" placeholder="XXXXX-XXXXX" />
            </div>
        </div>
    }
    else
    {
        <div class="otp mb-3" data-otp="code" data-otp-length="6">
            <InputText id="code" @bind-Value="Input!.Code" class="form-control form-control-lg text-center otp-fallback"
                       inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000" />
        </div>
    }
    <ValidationMessage For="() => Input.Code" class="text-danger small d-block text-center mb-2" />
    <button type="submit" class="btn btn-primary w-100 py-2">
        <i class="bi bi-shield-check me-1"></i> @L["Verificar e entrar"]
    </button>
</EditForm>

<p class="text-center small text-muted mt-4 mb-1">
    @if (UseRecovery)
    {
        <a href="@($"Account/LoginWith2fa?returnUrl={Uri.EscapeDataString(Target)}")" data-enhance-nav="false">@L["Usar o app autenticador"]</a>
    }
    else
    {
        <span>@L["Sem acesso ao celular?"]</span>
        <a href="@($"Account/LoginWith2fa?recovery=true&returnUrl={Uri.EscapeDataString(Target)}")" data-enhance-nav="false">@L["Usar código de recuperação"]</a>
    }
</p>
<p class="text-center small mb-0">
    <a href="Account/Login" data-enhance-nav="false"><i class="bi bi-arrow-left me-1"></i>@L["Voltar para o login"]</a>
</p>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private CodeInput? Input { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "recovery")] private bool UseRecovery { get; set; }

    private string _appName = "";
    private string? _error;
    private AppUser? _user;

    /// <summary>Só caminhos locais ("/x"; não "//host" nem "/\host").</summary>
    private string Target => !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl[0] == '/' &&
                             (ReturnUrl.Length == 1 || (ReturnUrl[1] != '/' && ReturnUrl[1] != '\\')) ? ReturnUrl : "/";

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        _appName = (await Dispatcher.QueryAsync(new GetBrandingQuery())).AppName;
        var pendingId = await UserSessions.TwoFactorUserIdAsync(HttpContext);
        _user = pendingId is null ? null : await UserManager.FindByIdAsync(pendingId);
        if (_user is { TwoFactorEnabled: false }) _user = null;
        if (_user is null)
        {
            // Cookie temporário expirou (ou acesso direto): recomeça pelo login
            Nav.NavigateTo("/Account/Login", forceLoad: true);
        }
    }

    private async Task VerifyAsync()
    {
        var user = _user;
        if (user is null) return;

        if (!user.IsActive || await UserManager.IsLockedOutAsync(user))
        {
            _error = L["Conta bloqueada temporariamente por excesso de tentativas. Tente novamente em alguns minutos."];
            return;
        }

        if (!await ReauthVerifier.VerifyCodeAsync(UserManager, user, Input!.Code))
        {
            await UserManager.AccessFailedAsync(user);
            if (await UserManager.IsLockedOutAsync(user))
            {
                Notifier.LockoutAlert(user.Id);
                _error = L["Conta bloqueada temporariamente por excesso de tentativas. Tente novamente em alguns minutos."];
            }
            else
            {
                _error = L["Código de verificação inválido."];
            }
            Input.Code = "";
            return;
        }

        await UserManager.ResetAccessFailedCountAsync(user);
        var remember = await UserSessions.TwoFactorRememberAsync(HttpContext);
        await UserSessions.EndTwoFactorAsync(HttpContext);
        await Sessions.SignInAsync(SignInManager, user, remember, mfa: true);
        Nav.NavigateTo(Target, forceLoad: true);
    }

    private sealed class CodeInput
    {
        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.MfaCodeRequired)), StringLength(20)]
        public string Code { get; set; } = "";
    }
}
