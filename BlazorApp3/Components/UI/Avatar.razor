@if (!string.IsNullOrEmpty(Url))
{
    <img class="avatar @Class" src="@Url" alt="@Name" style="width:@(Size)px;height:@(Size)px" />
}
else
{
    <span class="avatar avatar-initials @Class" title="@Name"
          style="width:@(Size)px;height:@(Size)px;font-size:@(Math.Round(Size * 0.4))px;background:@ColorFor(Name)">@Initials(Name)</span>
}

@code {
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Url { get; set; }
    [Parameter] public int Size { get; set; } = 36;
    [Parameter] public string? Class { get; set; }

    private static readonly string[] Palette = ["#6366f1", "#ec4899", "#14b8a6", "#f59e0b", "#8b5cf6", "#ef4444", "#0ea5e9", "#22c55e", "#f97316", "#64748b"];

    public static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
    }

    public static string ColorFor(string? name)
    {
        var hash = 0;
        foreach (var c in name ?? "") hash = (hash * 31 + c) & 0x7fffffff;
        return Palette[hash % Palette.Length];
    }
}
