@* Linha de configuração liga/desliga com título e descrição *@
<label class="settings-toggle">
    <span class="form-check form-switch m-0">
        <input type="checkbox" class="form-check-input" role="switch" checked="@Value" @onchange="OnChange" disabled="@Disabled" />
    </span>
    <span class="flex-grow-1">
        <span class="d-block fw-semibold">@Title</span>
        @if (!string.IsNullOrEmpty(Description))
        {
            <span class="d-block small text-muted">@Description</span>
        }
    </span>
</label>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private Task OnChange(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value is true);
}
