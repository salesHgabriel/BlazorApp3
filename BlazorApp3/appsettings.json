{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=app.db",
    "Hangfire": "hangfire.db"
  },
  "App": {
    "PublicUrl": ""
  },
  "Account": {
    "DefaultRole": "Visualizador",
    "CodeLength": 6,
    "CodeLifetimeMinutes": 15,
    "MaxCodeAttempts": 5,
    "ResendCooldownSeconds": 60,
    "UnconfirmedAccountRetentionDays": 7
  },
  "Email": {
    "Provider": "Pickup",
    "FromAddress": "no-reply@nexus.dev",
    "FromName": "Nexus Admin",
    "Pickup": {
      "Directory": "App_Data/emails"
    },
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "User": "",
      "Password": ""
    },
    "SendGrid": {
      "ApiKey": ""
    },
    "Mailtrap": {
      "ApiToken": "",
      "Endpoint": "https://send.api.mailtrap.io/api/send"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*"
}
